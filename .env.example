# Copia este archivo a .env si quieres personalizar las credenciales locales.
# docker-compose.yml ya trae estos mismos valores como default, así que
# `docker compose up` funciona sin este archivo. Son credenciales de
# desarrollo local unicamente — nunca las reales del despliegue.
DB_NAME=barberbooking
DB_USER=barberbooking
DB_PASSWORD=barberbooking
# 5433, no 5432: en esta máquina el 5432 ya lo ocupa un Postgres nativo de Windows.
DB_PORT=5433

# Cambia esto por una cadena larga y aleatoria antes de desplegar a cualquier
# lugar real. El valor por defecto (en application.properties) solo sirve
# para desarrollo local.
JWT_SECRET=this-is-a-local-dev-only-secret-key-please-change-me
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Zona horaria de la barbería (ajusta si tu negocio no está en esta zona).
BUSINESS_TIMEZONE=America/Guayaquil
SLOT_GRANULARITY_MINUTES=30
